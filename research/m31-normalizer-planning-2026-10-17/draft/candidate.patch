+// A factory is called once inside each complete method invocation. No cache escapes.
+// Keys are the invocation-owned exact prepared objects, never stable drone IDs.
+// Store only successful immutable intervals; exceptions retain their original site.
+function createQuery(){
+ const betas=new WeakMap(),nus=new WeakMap();
+ const cache={
+  beta(source){
+   if(betas.has(source))return betas.get(source);
+   const value=I.sqrt(iq(R.div(R.sum(source.forces),C.mg)));
+   betas.set(source,value);return value;
+  },
+  nu(receiver,rotor){
+   let values=nus.get(receiver);
+   if(values&&values.has(rotor))return values.get(rotor);
+   const value=I.sqrt(iq(R.div(receiver.forces[rotor],R.mul(R.mul(R.q(2n),C.rho),C.A))));
+   if(!values){values=new Map();nus.set(receiver,values);}
+   values.set(rotor,value);return value;
+  }
+ };
+ return (receiver,source,rotor)=>query(receiver,source,rotor,cache);
+}
