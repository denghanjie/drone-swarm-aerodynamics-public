  "purpose": "Exploratory aerodynamic sensitivity on matched local flock missions. No physical accuracy claim; no parameter fitting to held-out observations.",
  "models": {
    "off": "Existing rigid-body/Boids baseline with no airflow coupling",
    "sum-force": "Linear sum of prescribed mean-wake axial inflows; assumed constant ideal induced power per receiver rotor; net lift correction only, nominal moments retained",
    "sum-rotor": "Same summed inflow and power response; unequal rotor lift adds roll/pitch moments; nominal yaw torque retained",
    "rss-rotor": "Root-sum-square axial inflow heuristic with rotor lift roll/pitch moments; not a turbulent simulation"
  },
  "field": "Published normalized mean far-wake profile from step03a-source. Source amplitude is prescribed isolated hover weight, rotated with source attitude; it does not solve self-consistent source thrust/wake coupling. Receiver translational relative-flow effects, wake transport history, walls, ground effect and fluctuations are omitted. Source/receiver tilt>20deg or a receiver in the declared near-wake cylinder stops as model-domain exit.",
  "parameters": {
    "rho": 1.225,
    "rotorRadius": 0.023,
    "motorDistance": 0.056,
    "downstreamFade": 2,
    "downstreamCutoff": 2.5,
    "radialFade": 2,
    "radialCutoff": 3,
    "neighborRadius": 3,
    "maxTiltDegrees": 20,
    "nearFieldRadius": 0.15
  },
  "response": "For nominal isolated thrust f0 and incoming axial speed U, vi0=sqrt(f0/(2rhoA)), alpha=U/vi0; effective thrust=f0*x, where x^3+alpha*x-1=0. This preserves assumed instantaneous ideal induced power, not measured motor electrical power or calibrated PWM response.",
  "integration": "Rigid-body RK4 at2.5ms primary /1.25ms refinement,100Hz flight control. Wake fields held between10ms updates; a separate5ms field-update test uses1.25ms physics. Receiver loads respond to nominal motor states inside RK stages. Off branch reproduces the original integrator exactly.",
  "numerics": "Four full2.5→1.25ms comparisons: same completion/stop, end difference<.01s and max endpoint difference<.01m. The10→5ms field-refresh comparison uses same joint thresholds and is kept separate from physics-step convergence.",
  "design": "Two fresh50-drone seeds and two doorway sizes for all4 models; one200-drone wide seed for all4. No controller/geometry changes across matched cases; jittered3D initial clouds, no individual scheduling. No aerodynamic benefit claimed from a single case.",
  "timing": "Serial jobs within this study, potentially overlapping milestone26. Descriptive wall time only; isolated aerodynamic cost measurement is a separate later benchmark.",
  "energy": "nominalIdealEnergyJ integrates isolated-rotor ideal induced power implied by the nominal motor states. It is neither battery use nor independently validated energy consumption.",
  "records": "180s horizon; contacts/model-domain exits retained; scientific sampling0.1s; Float64LE replay every1s and terminal state; stage report and Three.js replay required. Development seed1401 is excluded from fresh mission evidence."
